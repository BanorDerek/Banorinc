# Copy this file to .env and fill in your real SMTP credentials.
# Works with any SMTP provider: your cPanel/Namecheap mailbox, Gmail
# (use an App Password, not your normal password), SendGrid, Mailgun, etc.

PORT=4000

# Where contact form submissions get delivered
CONTACT_TO_EMAIL=info@banorinc.com

# SMTP connection
SMTP_HOST=mail.banorinc.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@banorinc.com
SMTP_PASS=your-mailbox-password

# In production, lock this down to your real domain, e.g. https://banorinc.com
ALLOWED_ORIGIN=*
